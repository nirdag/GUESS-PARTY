# Copy to .env.local or set these as Azure App Service Application Settings.

# Runtime
NODE_ENV=production
PORT=8080

# Public URL of this app; used for CORS and for building email verification links.
APP_ORIGIN=https://<app-name>.azurewebsites.net

# Where the local JSON auth store is written (App Service persists /home across restarts).
GUESS_PARTY_DATA_DIR=/home/data

# Azure Communication Services Email (leave unset to fall back to console-logging links in dev).
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=
